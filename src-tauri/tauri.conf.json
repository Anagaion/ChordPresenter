{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../scripts/md_to_pro.py",
      "../scripts/ew_fetch.py",
      "../scripts/create_pro_song.py",
      "../scripts/parse_pro.py",
      "../scripts/chord_grammar.json"
    ]
  },
  "productName": "ChordPresenter",
  "mainBinaryName": "ChordPresenter",
  "version": "1.2.0",
  "identifier": "com.chordpresenter.app",
  "plugins": {},
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "ChordPresenter",
        "width": 640,
        "height": 780,
        "minWidth": 600,
        "minHeight": 680,
        "resizable": true,
        "useHttpsScheme": true,
        "label": "main",
        "dragDropEnabled": true
      }
    ]
  }
}
